# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.

# --- Database ---
DB_NAME=hashtopolis
DB_USER=hashtopolis
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

# --- Hashtopolis admin (web UI login) ---
HASHTOPOLIS_ADMIN_USER=admin
HASHTOPOLIS_ADMIN_PASSWORD=change-me-admin-password
